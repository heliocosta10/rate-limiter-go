# HTTP
APP_PORT=8080

# IP rate limit
RATE_LIMIT_IP=10

# Default rate limit for tokens that are not explicitly configured
RATE_LIMIT_TOKEN_DEFAULT=10

# Specific token limits. JSON object: token -> requests/second
TOKEN_LIMITS_JSON={"token-premium":100,"token-basic":20}

# How long an offender remains blocked, in seconds.
BLOCK_DURATION_SECONDS=300

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate-limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=1
